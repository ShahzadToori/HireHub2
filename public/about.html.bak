  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About Us – JobOrbit</title>
  <meta name="description" content="Learn about JobOrbit – the job board connecting thousands of job seekers with employers. Our mission, values, and team.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="/about.html">
  <meta property="og:type" content="website">
  <meta property="og:title" content="About Us – JobOrbit">
  <meta property="og:description" content="Learn about JobOrbit – the job board connecting thousands of job seekers with employers. Our mission, values, and team.">
  <meta property="og:site_name" content="JobOrbit">
  <link rel="icon" type="image/svg+xml" href="/JobOrbitFavicon.svg">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0f62fe">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .lp-hero{background:linear-gradient(135deg,#0d1117 0%,#161b22 60%,#0f2744 100%);padding:4rem 0 3rem;text-align:center;position:relative;overflow:hidden}
    .lp-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(15,98,254,.18) 0%,transparent 70%)}
    .lp-hero-icon{width:64px;height:64px;border-radius:18px;background:rgba(15,98,254,.2);border:1px solid rgba(15,98,254,.35);display:inline-flex;align-items:center;justify-content:center;font-size:1.75rem;color:#60a5fa;margin-bottom:1.25rem;position:relative}
    .lp-hero-title{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(1.75rem,4vw,2.75rem);color:#fff;margin-bottom:.6rem;position:relative}
    .lp-hero-sub{color:rgba(255,255,255,.6);font-size:.95rem;max-width:540px;margin:0 auto;position:relative}
    .lp-updated{display:inline-block;margin-top:1rem;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:100px;padding:.25rem .85rem;font-size:.75rem;color:rgba(255,255,255,.5);position:relative}
    .lp-body{padding:3.5rem 0 4rem}
    .lp-card{background:var(--bg-card);border:1px solid var(--border);border-radius:18px;padding:2.5rem;max-width:820px;margin:0 auto;box-shadow:var(--shadow)}
    @media(max-width:576px){.lp-card{padding:1.5rem 1.25rem;border-radius:12px}}
    .lp-section{margin-bottom:2.25rem}
    .lp-section:last-child{margin-bottom:0}
    .lp-section-title{font-family:'Syne',sans-serif;font-weight:700;font-size:1.1rem;color:var(--text-primary);margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:2px solid var(--border);display:flex;align-items:center;gap:.5rem}
    .lp-section-title i{color:var(--primary);font-size:1rem}
    .lp-card p,.lp-card li{color:var(--text-secondary);font-size:.93rem;line-height:1.75;margin-bottom:.5rem}
    .lp-card ul,.lp-card ol{padding-left:1.4rem;margin-bottom:.75rem}
    .lp-card a{color:var(--primary);text-decoration:none}
    .lp-card a:hover{text-decoration:underline}
    .lp-highlight{background:rgba(15,98,254,.06);border-left:3px solid var(--primary);border-radius:0 8px 8px 0;padding:.75rem 1rem;margin:1rem 0;font-size:.88rem;color:var(--text-secondary)}
    [data-theme="dark"] .lp-highlight{background:rgba(15,98,254,.1)}
    .lp-toc{position:sticky;top:80px;background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:1.25rem}
    .lp-toc-title{font-family:'Syne',sans-serif;font-weight:700;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:.75rem}
    .lp-toc a{display:block;padding:.3rem .5rem;border-radius:7px;font-size:.83rem;color:var(--text-secondary);text-decoration:none;transition:all .15s}
    .lp-toc a:hover{background:var(--surface);color:var(--primary)}
    .about-stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:1.5rem 0}
    @media(max-width:576px){.about-stat-grid{grid-template-columns:1fr 1fr}}
    .about-stat{text-align:center;padding:1.1rem;background:var(--surface);border-radius:12px}
    .about-stat-num{font-family:'Syne',sans-serif;font-weight:800;font-size:1.6rem;color:var(--primary)}
    .about-stat-lbl{font-size:.75rem;color:var(--text-muted);margin-top:.2rem}
    .value-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;margin-top:1rem}
    .value-card{padding:1.1rem;background:var(--surface);border-radius:12px;border-left:3px solid var(--primary)}
    .value-card i{color:var(--primary);font-size:1.2rem;margin-bottom:.4rem;display:block}
    .value-card-title{font-weight:700;font-size:.88rem;color:var(--text-primary);margin-bottom:.25rem}
    .value-card p{margin:0;font-size:.8rem!important}
  </style>
</head>
<body>
<nav class="navbar navbar-expand-lg sticky-top" id="mainNav">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <img id="site-logo" src="" alt="Logo" class="d-none" style="max-height:36px">
      <!-- <span id="site-name" class="brand-name">JobOrbit</span> -->
    </a>
    <div class="d-flex align-items-center gap-2 ms-auto">
      <button class="btn btn-icon theme-toggle" id="themeToggle" aria-label="Toggle theme">
        <i class="bi bi-moon-fill" id="themeIcon"></i>
      </button>
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <i class="bi bi-list fs-4"></i>
      </button>
    </div>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
        <li class="nav-item"><a class="nav-link" href="/">Browse Jobs</a></li>
        <li class="nav-item"><a class="nav-link" href="/#categories">Categories</a></li>
        <li class="nav-item"><a class="nav-link" href="/blog/">Blog</a></li>
        <li class="nav-item"><a class="nav-link" href="/contact.html">Post a Job</a></li>
        <li class="nav-item"><a class="nav-link" href="/feedback.html">Feedback</a></li>
        <li class="nav-item"><a class="nav-link nav-link-active" href="/about.html">About</a></li>
      </ul>
    </div>
  </div>
</nav>

<section class="lp-hero">
  <div class="container position-relative">
    <div class="lp-hero-icon"><i class="bi bi-people-fill"></i></div>
    <h1 class="lp-hero-title">About JobOrbit</h1>
    <p class="lp-hero-sub">We're on a mission to make job hunting simple, fast, and human.</p>
    <span class="lp-updated"><i class="bi bi-calendar3 me-1"></i>Last updated: June 2025</span>
  </div>
</section>

<section class="lp-body">
  <div class="container">
    <div class="row g-4 justify-content-center">
      <div class="col-lg-8">
        <div class="lp-card">
          <div class="lp-section">
            <h2 class="lp-section-title"><i class="bi bi-rocket-takeoff-fill"></i>Our Mission</h2>
            <p>JobOrbit was built with a simple idea: connecting the right people with the right opportunities should be effortless. We built a platform where employers can post jobs quickly and job seekers can find them just as fast — with direct contact via WhatsApp, phone, or email, no middlemen involved.</p>
            <div class="lp-highlight"><i class="bi bi-quote me-1"></i>We believe every job listing should lead to a real conversation, not a black hole.</div>
          </div>
          <div class="lp-section">
            <h2 class="lp-section-title"><i class="bi bi-bar-chart-fill"></i>JobOrbit by the Numbers</h2>
            <div class="about-stat-grid">
              <div class="about-stat"><div class="about-stat-num">10K+</div><div class="about-stat-lbl">Job Seekers</div></div>
              <div class="about-stat"><div class="about-stat-num">500+</div><div class="about-stat-lbl">Employers</div></div>
              <div class="about-stat"><div class="about-stat-num">95%</div><div class="about-stat-lbl">Response Rate</div></div>
            </div>
          </div>
          <div class="lp-section">
            <h2 class="lp-section-title"><i class="bi bi-patch-check-fill"></i>What We Stand For</h2>
            <div class="value-grid">
              <div class="value-card"><i class="bi bi-lightning-charge-fill"></i><div class="value-card-title">Speed</div><p>Jobs go live within 24 hours. Job seekers get direct contact info immediately.</p></div>
              <div class="value-card"><i class="bi bi-shield-check-fill"></i><div class="value-card-title">Trust</div><p>Every listing is reviewed before publication. We keep spam and fake jobs off our platform.</p></div>
              <div class="value-card"><i class="bi bi-universal-access"></i><div class="value-card-title">Accessibility</div><p>Free to post standard jobs. No hidden fees, no paywalls for job seekers — ever.</p></div>
              <div class="value-card"><i class="bi bi-globe2"></i><div class="value-card-title">Reach</div><p>SEO-optimized listings that appear in Google Jobs and get found by real candidates.</p></div>
            </div>
          </div>
          <div class="lp-section">
            <h2 class="lp-section-title"><i class="bi bi-tags-fill"></i>Listing Packages</h2>
            <p>We offer three tiers of job listings to suit every hiring need:</p>
            <ul>
              <li><strong>Standard (Free):</strong> Basic listing visible to all users, live within 24 hours after review.</li>
              <li><strong>Featured ($9.99/mo):</strong> Highlighted listing in the featured section with enhanced visibility.</li>
              <li><strong>Sponsored ($19.99/mo):</strong> Pinned at the top of all search results for maximum reach.</li>
            </ul>
          </div>
          <div class="lp-section">
            <h2 class="lp-section-title"><i class="bi bi-envelope-fill"></i>Get in Touch</h2>
            <p>Whether you are an employer looking to hire or a job seeker looking for opportunities, we would love to hear from you. Visit our <a href="/contact.html">contact page</a> or reach out directly and we will get back to you within 24 hours.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-4">
        <div class="footer-brand mb-2"><span class="brand-name" id="footer-site-name">JobOrbit</span></div>
        <p class="footer-desc">Connecting talent with opportunity. Find your next career move today.</p>
      </div>
      <div class="col-md-4">
        <h6 class="footer-heading">Quick Links</h6>
        <ul class="footer-links">
          <li><a href="/">Browse Jobs</a></li>
          <li><a href="#categories">Categories</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact.html">Post a Job</a></li>
         
        </ul>
      </div>
      <div class="col-md-4">
        <h6 class="footer-heading">Legal &amp; Info</h6>
        <ul class="footer-links">
            <li><a href="/about.html">About Us</a></li>
          <li><a href="/feedback.html">Contact Us</a></li>
          <li><a href="/privacy-policy.html">Privacy Policy</a></li>
          <li><a href="/terms.html">Terms &amp; Conditions</a></li>
          <li><a href="/disclaimer.html">Disclaimer</a></li>
        </ul>
      </div>
    </div>
    <hr class="footer-divider">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
      <p class="mb-0 footer-copy">&copy; <span id="footerYear"></span> <span id="footer-copy-name">JobOrbit</span>. All rights reserved.</p>
      <div class="d-flex gap-3">
         <a href="/about.html" class="footer-copy" style="text-decoration:none">About</a>
        <a href="/privacy-policy.html" class="footer-copy" style="text-decoration:none">Privacy</a>
        <a href="/terms.html" class="footer-copy" style="text-decoration:none">Terms</a>
        <a href="/disclaimer.html" class="footer-copy" style="text-decoration:none">Disclaimer</a>
      </div>
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" defer></script>
<script>
async function loadSettings() {
  try {
    const data = await fetch('/api/settings').then(r => r.json());
    const s = data.settings;
    if (s.primary_color)   document.documentElement.style.setProperty('--primary', s.primary_color);
    if (s.secondary_color) document.documentElement.style.setProperty('--secondary', s.secondary_color);
    if (s.site_name) {
      document.querySelectorAll('.brand-name').forEach(el => el.textContent = s.site_name);
      document.getElementById('footer-copy-name').textContent = s.site_name;
      document.title = document.title.replace('JobOrbit', s.site_name);
    }
    if (s.logo_url) {
      const logo = document.getElementById('site-logo');
      logo.src = s.logo_url; logo.classList.remove('d-none');
    }
    applyTheme(localStorage.getItem('theme') || s.default_theme || 'light', false);
  } catch {}
}
function applyTheme(theme, save = true) {
  document.documentElement.setAttribute('data-theme', theme);
  document.documentElement.style.colorScheme = theme;
  document.getElementById('themeIcon').className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
  if (save) localStorage.setItem('theme', theme);
}
document.getElementById('themeToggle').addEventListener('click', () => {
  applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
});
document.getElementById('footerYear').textContent = new Date().getFullYear();
loadSettings();
</script>
</body>
</html>