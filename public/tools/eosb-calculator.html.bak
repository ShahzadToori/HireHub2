    </div>
  </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" defer></script>
<script>
(function(){
  async function loadSettings(){
    try{
      const d=await fetch('/api/settings').then(r=>r.json());
      const s=d.settings;
      if(s.primary_color)document.documentElement.style.setProperty('--primary',s.primary_color);
      if(s.secondary_color)document.documentElement.style.setProperty('--secondary',s.secondary_color);
      if(s.site_name){
        document.querySelectorAll('.brand-name').forEach(e=>e.textContent=s.site_name);
        const fc=document.getElementById('footer-copy-name');if(fc)fc.textContent=s.site_name;
      }
      if(s.logo_url){const l=document.getElementById('site-logo');l.src=s.logo_url;l.classList.remove('d-none');}
      applyTheme(localStorage.getItem('theme')||s.default_theme||'light',false);
    }catch(e){}
  }
  function applyTheme(t,save=true){
    document.documentElement.setAttribute('data-theme',t);
    document.documentElement.style.colorScheme=t;
    const i=document.getElementById('themeIcon');
    if(i)i.className=t==='dark'?'bi bi-sun-fill':'bi bi-moon-fill';
    if(save)localStorage.setItem('theme',t);
  }
  const tb=document.getElementById('themeToggle');
  if(tb)tb.addEventListener('click',()=>applyTheme(document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark'));
  const fy=document.getElementById('footerYear');if(fy)fy.textContent=new Date().getFullYear();
  loadSettings();
})();
</script>
<script>
function fmt(n){return'SAR '+Math.round(n).toLocaleString('en-SA');}
function calcEOSB(){
  const salary=parseFloat(document.getElementById('eosbSalary').value)||0;
  const years=parseFloat(document.getElementById('eosbYears').value)||0;
  const reason=document.getElementById('eosbReason').value;
  if(salary<=0||years<=0){alert('Please enter salary and years of service.');return;}

  let first5=0,after5=0,total=0,multiplier=1;

  if(reason==='resigned2'){total=0;multiplier=0;}
  else if(reason==='resigned'&&years>=2&&years<5){multiplier=1/3;}
  else if(reason==='resigned5'||reason==='terminated'){multiplier=1;}

  if(multiplier>0){
    const y1=Math.min(years,5);
    const y2=Math.max(years-5,0);
    first5=y1*(salary/2);
    after5=y2*salary;
    total=(first5+after5)*multiplier;
  }

  const rb=document.getElementById('eosbResult');
  rb.classList.add('show');
  document.getElementById('eosbTotal').textContent=fmt(total);

  let rows='';
  if(multiplier===0){
    rows='<div class="result-row"><span class="result-row-label">Less than 2 years service</span><span class="result-row-val" style="color:#dc2626">No EOSB entitlement</span></div>';
  } else {
    const y1=Math.min(years,5);
    const y2=Math.max(years-5,0);
    if(y1>0) rows+=`<div class="result-row"><span class="result-row-label">First ${y1.toFixed(1)} years (× ½ month)</span><span class="result-row-val green">${fmt(first5*multiplier)}</span></div>`;
    if(y2>0) rows+=`<div class="result-row"><span class="result-row-label">After 5 years — ${y2.toFixed(1)} yrs (× 1 month)</span><span class="result-row-val green">${fmt(after5*multiplier)}</span></div>`;
    if(multiplier===1/3) rows+=`<div class="result-row"><span class="result-row-label">Resignation deduction (⅓ rule)</span><span class="result-row-val" style="color:#d97706">Applied</span></div>`;
    rows+=`<div class="result-row"><span class="result-row-label" style="font-weight:700">Total Gratuity</span><span class="result-row-val blue" style="font-size:1.05rem">${fmt(total)}</span></div>`;
  }
  document.getElementById('eosbBreakdown').innerHTML=rows;
}</script>
</body>
</html>