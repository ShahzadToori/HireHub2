<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>End of Service Gratuity Calculator Saudi Arabia 2026 - JobOrbit</title>
  <meta name="description" content="Calculate your exact EOSB gratuity under Saudi Labour Law. Based on salary and years of service. Free, instant, accurate.">
  <meta name="robots" content="index, follow, max-snippet:-1">
  <link rel="canonical" href="/tools/eosb-calculator.html">
  <meta property="og:type" content="website">
  <meta property="og:title" content="End of Service Gratuity Calculator Saudi Arabia 2026">
  <meta property="og:description" content="Calculate your exact EOSB gratuity under Saudi Labour Law. Based on salary and years of service. Free, instant, accurate.">
  <meta property="og:site_name" content="JobOrbit">
  <meta name="twitter:card" content="summary">
  <link rel="icon" type="image/svg+xml" href="/JobOrbitFavicon.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0f62fe">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
  /* Tool hero */
  .tool-hero{background:linear-gradient(135deg,#0d1117 0%,#161b22 55%,#0f2744 100%);padding:3.5rem 0 2.75rem;position:relative;overflow:hidden;text-align:center}
  .tool-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(15,98,254,.2),transparent 70%)}
  .tool-hero-inner{position:relative}
  .tool-badge{display:inline-flex;align-items:center;gap:.4rem;background:rgba(15,98,254,.18);border:1px solid rgba(15,98,254,.3);border-radius:100px;padding:.28rem .85rem;font-size:.72rem;font-weight:700;color:#60a5fa;text-transform:uppercase;letter-spacing:.07em;margin-bottom:.9rem}
  .tool-hero h1{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(1.7rem,4vw,2.8rem);color:#fff;line-height:1.12;margin-bottom:.6rem}
  .tool-hero p{color:rgba(255,255,255,.6);font-size:.95rem;max-width:540px;margin:0 auto}
  /* Calculator card */
  .calc-card{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:2.25rem;box-shadow:var(--shadow)}
  @media(max-width:576px){.calc-card{padding:1.5rem 1.25rem;border-radius:14px}}
  /* Form fields */
  .calc-label{font-size:.82rem;font-weight:700;color:var(--text-secondary);margin-bottom:.4rem;display:block;letter-spacing:.02em}
  .calc-input,.calc-select{width:100%;padding:.7rem .95rem;border:1.5px solid var(--border);border-radius:11px;background:var(--bg-card);color:var(--text-primary);font-family:'DM Sans',sans-serif;font-size:.93rem;outline:none;transition:border-color .18s,box-shadow .18s;appearance:none}
  .calc-input:focus,.calc-select:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(15,98,254,.12)}
  /* Result box */
  .result-box{background:linear-gradient(135deg,rgba(15,98,254,.08),rgba(15,98,254,.04));border:1.5px solid rgba(15,98,254,.2);border-radius:14px;padding:1.5rem;margin-top:1.5rem;display:none}
  .result-box.show{display:block;animation:fadeUp .25s ease}
  @keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .result-main{font-family:'Syne',sans-serif;font-weight:800;font-size:2rem;color:var(--primary);margin-bottom:.25rem}
  .result-label{font-size:.82rem;color:var(--text-muted);margin-bottom:1rem}
  .result-row{display:flex;justify-content:space-between;align-items:center;padding:.45rem 0;border-bottom:1px solid var(--border);font-size:.875rem}
  .result-row:last-child{border-bottom:none}
  .result-row-label{color:var(--text-secondary)}
  .result-row-val{font-weight:700;color:var(--text-primary)}
  .result-row-val.green{color:#059669}
  .result-row-val.blue{color:var(--primary)}
  /* Calc button */
  .btn-calc{width:100%;padding:.85rem;background:var(--primary);color:#fff;border:none;border-radius:11px;font-family:'Syne',sans-serif;font-weight:700;font-size:.97rem;cursor:pointer;transition:background .15s,transform .12s,box-shadow .15s;margin-top:.25rem}
  .btn-calc:hover{background:#0353e9;transform:translateY(-1px);box-shadow:0 6px 20px rgba(15,98,254,.28)}
  /* Info box */
  .info-box{background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.25);border-radius:10px;padding:.85rem 1rem;font-size:.82rem;color:var(--text-secondary);margin-top:1.25rem;display:flex;gap:.65rem}
  .info-box i{color:#d97706;flex-shrink:0;margin-top:.1rem}
  /* Related tools */
  .related-tool{display:flex;align-items:center;gap:.85rem;padding:.85rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:12px;text-decoration:none;transition:border-color .15s,transform .15s;margin-bottom:.6rem}
  .related-tool:hover{border-color:var(--primary);transform:translateX(3px);text-decoration:none}
  .related-tool-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.05rem;flex-shrink:0}
  .related-tool-title{font-weight:700;font-size:.88rem;color:var(--text-primary);display:block}
  .related-tool-desc{font-size:.75rem;color:var(--text-muted)}
  /* Sidebar widget */
  .sidebar-widget{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:1.25rem;margin-bottom:1.25rem}
  .sidebar-widget-title{font-family:'Syne',sans-serif;font-weight:700;font-size:.82rem;text-transform:uppercase;letter-spacing:.07em;color:var(--text-muted);margin-bottom:.85rem}
</style>
</head>
